# ค่าบนเซิร์ฟเวอร์ (ห้าม commit ค่าจริง) · ใช้กับ infra/prod/compose.yml
APP_HOST=app.example.com
API_IMAGE=rental-api:latest
POSTGRES_SUPERUSER_PASSWORD=
RENTAL_OWNER_PASSWORD=
RENTAL_API_DB_PASSWORD=
VALKEY_PASSWORD=
S3_BUCKET=
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
# กุญแจเข้ารหัส secret ของยืนยันตัวตน 2 ชั้น · สร้างด้วย: openssl rand -base64 32 · ห้ามเปลี่ยน (เปลี่ยน = ทุกคนต้องตั้ง 2 ชั้นใหม่)
TOTP_ENC_KEY=
